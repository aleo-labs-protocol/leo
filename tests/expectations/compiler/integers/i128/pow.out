program test.aleo;

function main:
    input r0 as i128.private;
    input r1 as i128.private;
    input r2 as i128.private;
    pow r0 2u8 into r3;
    pow r0 2u16 into r4;
    pow r0 2u32 into r5;
    is.eq r3 r4 into r6;
    is.eq r5 r2 into r7;
    and r6 r7 into r8;
    output r8 as boolean.private;

constructor:
    assert.eq edition 0u16;
