program test.aleo;

struct Data:
    values as [u32; 2u32];

function struct_field:
    input r0 as u32.private;
    cast r0 1u32 into r1 as [u32; 2u32];
    cast r1[0u32] 7u32 into r2 as [u32; 2u32];
    add r2[0u32] r2[1u32] into r3;
    output r3 as u32.private;

function nested_row:
    input r0 as u32.private;
    cast r0 1u32 into r1 as [u32; 2u32];
    cast r1[0u32] 7u32 into r2 as [u32; 2u32];
    add r2[0u32] r2[1u32] into r3;
    output r3 as u32.private;

constructor:
    assert.eq edition 0u16;
