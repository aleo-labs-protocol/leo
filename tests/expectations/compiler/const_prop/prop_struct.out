program test.aleo;

struct S:
    x as u8;
    y as u8;

struct Nested:
    inner as S;

function main:
    output 1u8 as u8.private;

function projections:
    input r0 as u8.private;
    assert.eq r0 3u8;
    output false as boolean.private;
    output true as boolean.private;

constructor:
    assert.eq edition 0u16;
