program provider.aleo;

function entry:
    input r0 as u32.private;
    output r0 as u32.private;

constructor:
    assert.eq edition 0u16;
// --- Next Program --- //
import provider.aleo;
program caller.aleo;

function main:
    input r0 as u32.private;
    add r0 1u32 into r1;
    add r0 2u32 into r2;
    add r1 r2 into r3;
    assert.eq r3 13u32;
    output r3 as u32.private;

constructor:
    assert.eq edition 0u16;
status: success
output: 13u32
