program test.aleo;

struct Point:
    x as u32;
    y as u32;

function select:
    input r0 as boolean.private;
    input r1 as [Point; 3u32].private;
    input r2 as [Point; 3u32].private;
    ternary r0 r1 r2 into r3;
    output r3 as [Point; 3u32].private;

constructor:
    assert.eq edition 0u16;
status: success
output: [
  {
    x: 1u32,
    y: 2u32
  },
  {
    x: 3u32,
    y: 4u32
  },
  {
    x: 5u32,
    y: 6u32
  }
]
status: success
output: [
  {
    x: 10u32,
    y: 20u32
  },
  {
    x: 30u32,
    y: 40u32
  },
  {
    x: 50u32,
    y: 60u32
  }
]
